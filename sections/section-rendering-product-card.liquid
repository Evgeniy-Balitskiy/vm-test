{% comment %}
  This section is only to be called by the Section Rendering API. Faster to render a single card than the entire product grid.

  HTML updated based on client-side interactions needs to be rendered here.  It is not important to have the exact
  same HTML structure as the final rendered product card. The variant-picker.js script will morph specific elements as needed.
{% endcomment %}

{% liquid
  if product == blank
    assign product = closest.product
  endif

  if settings.transition_to_main_product
    assign featured_media_url = product.selected_or_first_available_variant.featured_image | image_url: width: 500
    if featured_media_url == blank
      assign featured_media_url = product.featured_media.preview_image | image_url: width: 500
    endif
  endif

  assign url = product.selected_or_first_available_variant.url
  unless url
    assign url = product.first_available_variant.url
  endunless
  unless url
    assign url = product.url
  endunless

  assign sku = product.selected_or_first_available_variant.sku
  assign product_color_group = product.metafields.custom.product_color_group.value
  assign sibling_products = product_color_group.products.value

  assign featured_media = product.selected_or_first_available_variant.featured_media
  if featured_media == blank
    assign featured_media = product.featured_media
  endif

  assign featured_image = featured_media.preview_image
  assign hover_media = blank
  for media in product.media
    unless media.id == featured_media.id
      assign hover_media = media
      break
    endunless
  endfor

  if hover_media == blank
    assign hover_media = featured_media
  endif
  assign hover_image = hover_media.preview_image
%}

<product-card
  data-product-id="{{ product.id }}"
  {% # theme-check-disable UnknownFilter %}
  view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
  {% # theme-check-enable UnknownFilter %}
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    {% if featured_media_url != blank %}
      data-featured-media-url="{{ featured_media_url }}"
    {% endif %}
    on:click="/handleViewTransition"
  {% endif %}
>
  <a
    href="{{ url }}"
    ref="productCardLink"
  >
    <variant-picker>
      <script type="application/json">
        {{ product.selected_or_first_available_variant | json }}
      </script>
    </variant-picker>
    {% if sibling_products != blank %}
      {% render 'sibling-product-swatches', product_resource: product, has_product_selected: true %}
    {% else %}
      {% render 'variant-swatches', product_resource: product, has_option_selected: true %}
    {% endif %}

    {% render 'product-card-badges', product: product %}

    <product-price>
      {% render 'price', product_resource: product, show_unit_price: true, show_sale_price_first: true %}
    </product-price>

    <product-sku-component
      data-product-id="{{ product.id }}"
      style="{% if sku == blank %}display: none;{% else %}display: block;{% endif %}"
    >
      {% render 'sku', product_resource: product %}
    </product-sku-component>
  </a>

  <div
    data-sibling-product-card-update
    data-product-id="{{ product.id }}"
    data-product-url="{{ url }}"
    data-product-title="{{ product.title | escape }}"
    data-featured-media-id="{{ featured_media.id }}"
    {% if featured_image != blank %}
      data-featured-image-src="{{ featured_image | image_url: width: 900 }}"
      data-featured-image-srcset="{{ featured_image | image_url: width: 352 }} 352w, {{ featured_image | image_url: width: 832 }} 832w, {{ featured_image | image_url: width: 1200 }} 1200w"
      data-featured-image-alt="{{ featured_image.alt | default: product.title | escape }}"
    {% endif %}
    {% if hover_image != blank %}
      data-hover-image-src="{{ hover_image | image_url: width: 900 }}"
      data-hover-image-srcset="{{ hover_image | image_url: width: 352 }} 352w, {{ hover_image | image_url: width: 832 }} 832w, {{ hover_image | image_url: width: 1200 }} 1200w"
      data-hover-image-alt="{{ hover_image.alt | default: product.title | escape }}"
    {% endif %}
  >
    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  </div>
</product-card>

{% schema %}
{
  "name": "t:names.product_card_rendering",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    }
  ]
}
{% endschema %}
